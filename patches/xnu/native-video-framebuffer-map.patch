--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -623,6 +623,27 @@
 	// the early debugger rather than corrupting memory or forging a map.
 	b Lbootstrap_tables_exhausted
 Lbootstrap_tables_ready:
+	/*
+	 * Map the video frame buffer.
+	 *
+	 * The kernel reaches the panel long before the video console exists, so
+	 * the frame buffer is not mapped by the kernel's own page tables yet.  The
+	 * boot arguments carry the physical address the firmware gave the panel;
+	 * map it identity in the low (V=P) table so that early code, a probe or a
+	 * panic can reach the screen.  One 1 GiB block covers any panel.
+	 */
+	mov	x13, x1				// the V=P L1 table
+	mov	x14, x2				// the free table pointer
+	ldr	x0, [x20, #0x28]		// boot args Video[0]: the frame buffer
+	cbz	x0, 1f
+	mov	x1, x0				// identity: virtual = physical
+	mov	x2, #1				// one 1 GiB block entry
+	mov	x3, x13				// the V=P L1 table
+	mov	x4, x14				// the free table pointer
+	create_bootstrap_mapping x0, x1, x2, x3, x4, x5, x6, x7, x8, x9
+	mov	x2, x4				// the advanced free table pointer
+1:
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
