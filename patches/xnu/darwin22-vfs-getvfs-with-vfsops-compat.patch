+/* Compatibility export for the iOS 16.7.16 (Darwin 22) kernelcache ABI. */
+mount_t
+vfs_getvfs_with_vfsops(fsid_t *fsid, const struct vfsops *ops)
+{
+	mount_t mp = vfs_getvfs(fsid);
+
+	if (mp != NULL && mp->mnt_op != ops) {
+		mp = NULL;
+	}
+	return mp;
+}
