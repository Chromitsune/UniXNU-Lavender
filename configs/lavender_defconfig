# Kernel configuration of the lavender image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
# Seeded from the proven sheng defconfig with the board realities swapped:
#   - UFS -> eMMC (SDHCI v5): CONFIG_XNU_NATIVE_UFS is off; storage root runs on
#     XNU_NATIVE_RAM_BLOCK until the planned NativeEmmc (qcom,sdhci-msm-v5)
#     kernel driver lands, then native-ufs-root-style args flip to eMMC root.
#   - Virtio block off (no para-virtual devices on hardware).
#   - Adreno off for first boot (A5xx bring-up is its own milestone after the
#     console/display stack converges; sheng's A740 path is the reference).
#   - No sheng PMGR (SDM660 uses the RPM-era PM660/PM660L PMIC pair).
#   - Owner boot ladders OFF for first boot: each rung requires
#     OWNER_ROOT_TRUST=1 (cache-mount -> cache-startup -> boot-manifest ->
#     data-mount -> union-SystemOS), and TRUST itself demands a verified
#     native block driver (sheng pairs it with VirtioBlock). Audit + probe
#     stay on; the ladder comes back with the eMMC driver. The same applies
#     to boot-progress telemetry (XNU_BOOT_PROGRESS gate names UFS/Virtio).

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE=""
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
